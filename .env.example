# ── 디스코드 ──
# 개발자 포털 → Bot → "토큰 초기화" 로 발급 (한 번만 보임)
DISCORD_TOKEN=여기에_봇_토큰

# 서버(길드) ID — 디스코드 설정 → 고급 → 개발자 모드 켠 뒤 서버 아이콘 우클릭 → "서버 ID 복사"
# 넣으면 슬래시 명령이 즉시 반영됨 (비우면 전역 동기화, 최대 1시간 지연)
GUILD_ID=

# ── Cloudflare R2 ──
# 대시보드 → R2 → 개요 우측 "Account ID"
R2_ACCOUNT_ID=
# R2 → "R2 API 토큰 관리" → 토큰 생성 (권한: 객체 읽기 및 쓰기, 버킷 지정)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 만들어둔 버킷 이름
R2_BUCKET=discord-save

# ── 동작 옵션 ──
# 다운로드 링크 유효 시간(시간). 지나면 R2에서 자동 삭제. 봇 대사에도 반영됨
LINK_TTL_HOURS=1
# ZIP 하나 최대 크기(MB). 넘으면 part1, part2… 로 분할
MAX_ZIP_MB=1500
# 1 이면 mp4/mov/webm 동영상도 포함
INCLUDE_VIDEO=0
# 커서 DB 저장 폴더
DATA_DIR=./data
